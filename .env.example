# Local demo only. Copy to .env and replace values for your environment.
APP_ENV=development
APP_NAME=Takamol MVP
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/takamol.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true
DEMO_RECORD_COUNT=120
VITE_API_BASE_URL=http://localhost:8000/api/v1
