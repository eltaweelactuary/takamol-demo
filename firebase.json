{
  "hosting": [
    {
      "target": "takamol-demo",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git/**",
        "**/.*",
        "backend/**",
        "frontend/**",
        "config/**",
        "models/**",
        "*.md",
        "*.txt",
        "*.log",
        "*.json",
        ".env.example"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    }
  ]
}
